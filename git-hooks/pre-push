#!/bin/sh
set -eu

remote_url=${2-}

case "$remote_url" in
  git@ssh.possumtech.com:* | ssh://git@ssh.possumtech.com/* | https://repo.possumtech.com/*)
    ;;
  *)
    exit 0
    ;;
esac

is_zero_oid() {
  case "$1" in
    "" | *[!0]*)
      return 1
      ;;
    *)
      return 0
      ;;
  esac
}

is_valid_branch() {
  branch=$1

  if [ "$branch" = "main" ]; then
    return 0
  fi

  case "$branch" in
    build/* | chore/* | ci/* | docs/* | feat/* | fix/* | perf/* | refactor/* | revert/* | style/* | test/*)
      slug=${branch#*/}
      ;;
    *)
      return 1
      ;;
  esac

  case "$slug" in
    "" | -* | *- | *--* | *[!a-z0-9-]*)
      return 1
      ;;
    *)
      return 0
      ;;
  esac
}

while read -r local_ref local_oid remote_ref remote_oid; do
  if is_zero_oid "$local_oid"; then
    if [ "$remote_ref" = "refs/heads/main" ]; then
      printf "%s\n" "PossumTech main cannot be deleted." >&2
      exit 1
    fi
    continue
  fi

  if [ "$remote_ref" = "refs/heads/main" ] &&
     ! is_zero_oid "$remote_oid" &&
     ! git merge-base --is-ancestor "$remote_oid" "$local_oid"; then
    printf "%s\n" "PossumTech main accepts fast-forward updates only." >&2
    exit 1
  fi

  case "$remote_ref" in
    refs/heads/*)
      branch=${remote_ref#refs/heads/}
      if ! is_valid_branch "$branch"; then
        printf "Invalid PossumTech branch '%s'.\n" "$branch" >&2
        printf "%s\n" "Expected main or <type>/<lowercase-slug>." >&2
        exit 1
      fi
      ;;
  esac
done
